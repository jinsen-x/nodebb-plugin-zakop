    "*.js": [
      "eslint --fix",
      "git add"
    ]
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jinsen-x/nodebb-plugin-zakop/issues"
  },
  "readmeFilename": "README.md",
  "nbbpm": {
    "compatibility": "^3.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.3.1",
    "@commitlint/config-angular": "20.3.1",
    "eslint": "9.39.2",
    "eslint-config-nodebb": "1.1.11",
    "husky": "9.1.7",
    "lint-staged": "16.2.7"
  }
}
