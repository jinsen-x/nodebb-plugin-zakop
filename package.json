{
  "name": "nodebb-plugin-zakop",
  "version": "0.1.0",
  "description": "Zakop plugin",
  "main": "library.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/jinsen-x/nodebb-plugin-zakop"
  },
  "scripts": {
    "lint": "eslint ."
  },
  "keywords": [
    "nodebb",
    "plugin",
    "quickstart",
    "shell"
  ],
  "husky": {
    "hooks": {
